{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noLib": true,
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "target": "ESNext",
    "types": ["compiler-types"],
    "typeRoots": ["node_modules/@rbxts"]
  },
  "include": ["src"]
}
